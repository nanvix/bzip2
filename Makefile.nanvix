#
# Usage: make -f Makefile.nanvix PLATFORM=<platform> PROCESS_MODE=<mode> \
#    MEMORY_SIZE=<size> NANVIX_HOME=<home> NANVIX_TOOLCHAIN=<toolchain> [target]
#
# Targets:
#   all: Build the default target
#   test-functional: Run functional tests (compress/decompress roundtrips on nanvixd$(EXE))
#   test: Alias for test-functional
#   package: Create a release tarball with build artifacts and headers
#   verify-package: Verify the contents of the release tarball
#   clean: Remove build artifacts and test executables

# ===========================================================================
# Global Variables
# ===========================================================================

# Some assumptions:
# 1. This makefile is ONLY called by z.py
# 2. Build mode ALWAYS runs in Docker
# 3. Build ALWAYS runs before test and release

.DEFAULT_GOAL=all
EXE = .elf
_NANVIX_DOCKER_BUILD_GOALS := all install bzip2$(EXE)
_NANVIX_GOALS := $(or $(MAKECMDGOALS),$(.DEFAULT_GOAL))

# Ensure required variables are defined
_REQUIRED := PLATFORM PROCESS_MODE MEMORY_SIZE NANVIX_HOME NANVIX_TOOLCHAIN \
    LIB_OUT INCLUDE_OUT BIN_OUT
ifneq ($(filter-out clean,$(_NANVIX_GOALS)),)
  $(foreach v,$(_REQUIRED),\
    $(if $($v),,$(error Required variable $v not set))\
  )
endif

CFLAGS = -O2 -Wall -D_FILE_OFFSET_BITS=64 -DBZ_UNIX -DBZ_LCCWIN32=0
ARFLAGS = rcs
STATICLIB = libbz2.a
OBJS = blocksort.o huffman.o crctable.o randtable.o compress.o decompress.o bzlib.o
PROG := bzip2$(EXE)
SYSROOT_PATH := $(abspath $(NANVIX_HOME))
LIB_ARTIFACTS := $(STATICLIB)
INCLUDE_ARTIFACTS := bzlib.h
BIN_ARTIFACTS := $(PROG)
RELEASE_ARTIFACTS := $(LIB_ARTIFACTS) $(INCLUDE_ARTIFACTS) $(BIN_ARTIFACTS)

# ===========================================================================
# Build Mode Variables
# ===========================================================================

_BUILD := $(filter $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
_NONBUILD := $(filter-out $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
ifneq ($(_BUILD),)
  # Error out if mixing build and non-build goals
  ifneq ($(_NONBUILD),)
    $(error Cannot mix build and non-build targets. Build targets: $(_NANVIX_DOCKER_BUILD_GOALS))
  endif

  ifeq ($(wildcard $(NANVIX_TOOLCHAIN)/bin/i686-nanvix-gcc),)
      $(error Nanvix toolchain not found at $(NANVIX_TOOLCHAIN))
  endif
endif

CC := $(NANVIX_TOOLCHAIN)/bin/i686-nanvix-gcc
AR := $(NANVIX_TOOLCHAIN)/bin/i686-nanvix-ar
# Since Nanvix 0.16.19, process startup (`_start`) lives in libnvx_crt0.a; it
# drives `__nanvix_libc_start_main` in libposix.a. It must be linked first so
# its strong `_start` overrides the toolchain's weak no-op stub (otherwise the
# guest never reaches main and hangs). The wildcard keeps this a no-op on older
# Nanvix releases that do not ship libnvx_crt0.a. libnvx_crt0.a and libposix.a
# share some kcall objects, so allow multiple definitions to resolve the overlap.
NANVIX_LDFLAGS := -T$(SYSROOT_PATH)/lib/user.ld -static -Wl,-z,noexecstack -Wl,--allow-multiple-definition
NANVIX_LIBS := -Wl,--start-group \
  $(wildcard $(SYSROOT_PATH)/lib/libnvx_crt0.a) \
  $(SYSROOT_PATH)/lib/libposix.a \
  $(NANVIX_TOOLCHAIN)/i686-nanvix/lib/libc.a \
  $(NANVIX_TOOLCHAIN)/i686-nanvix/lib/libm.a \
  -Wl,--end-group


# ===========================================================================
# Build Targets
# ===========================================================================

all: $(STATICLIB) $(PROG) install

# Stage built artifacts into the release output tree so that
# `./z release` (which packages release_dir()) can find them.
install: $(STATICLIB) $(PROG)
	@mkdir -p $(LIB_OUT) $(INCLUDE_OUT) $(BIN_OUT)
	cp -f $(LIB_ARTIFACTS)     $(LIB_OUT)/
	cp -f $(INCLUDE_ARTIFACTS) $(INCLUDE_OUT)/
	cp -f $(BIN_ARTIFACTS)     $(BIN_OUT)/

$(STATICLIB): $(OBJS)
	$(AR) $(ARFLAGS) $@ $(OBJS)

bzip2$(EXE): bzip2.o $(STATICLIB)
	$(CC) $(CFLAGS) $(NANVIX_LDFLAGS) -o $@ bzip2.o -L. -lbz2 $(NANVIX_LIBS)

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

# ===========================================================================
# Test Targets
# ===========================================================================

# --- Functional tests: compress/decompress roundtrip on nanvixd$(EXE) ---
test-functional:
	@test -f $(PROG) || { echo "  FAIL: $(PROG) not found"; exit 1; }
	@echo "=== bzip2 functional tests ==="
ifeq ($(PROCESS_MODE),standalone)
	@echo "  NOTE: Standalone functional tests are handled via ./z.sh."
	@echo "  Delegating to: ./z.sh test test-functional"
	@./z.sh test test-functional
else
	@echo "  Test 1: Compress/decompress roundtrip (sample1, -1, platform=$(PLATFORM), mode=$(PROCESS_MODE))..."
	@cp $(abspath tests/sample1.ref) /tmp/sample1.ref
	@cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd$(EXE) -- $(abspath bzip2$(EXE)) -1 -k -f /tmp/sample1.ref
	@cp /tmp/sample1.ref.bz2 /tmp/sample1_rt.bz2
	@cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd$(EXE) -- $(abspath bzip2$(EXE)) -d -k -f /tmp/sample1_rt.bz2
	@cmp /tmp/sample1_rt $(abspath tests/sample1.ref)
	@echo "  PASS: sample1 roundtrip"
	@echo "  Test 2: Compress/decompress roundtrip (sample2, -2, platform=$(PLATFORM), mode=$(PROCESS_MODE))..."
	@cp $(abspath tests/sample2.ref) /tmp/sample2.ref
	@cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd$(EXE) -- $(abspath bzip2$(EXE)) -2 -k -f /tmp/sample2.ref
	@cp /tmp/sample2.ref.bz2 /tmp/sample2_rt.bz2
	@cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd$(EXE) -- $(abspath bzip2$(EXE)) -d -k -f /tmp/sample2_rt.bz2
	@cmp /tmp/sample2_rt $(abspath tests/sample2.ref)
	@echo "  PASS: sample2 roundtrip"
	@echo "  Test 3: Compress/decompress roundtrip (sample3, -3, platform=$(PLATFORM), mode=$(PROCESS_MODE))..."
	@cp $(abspath tests/sample3.ref) /tmp/sample3.ref
	@cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd$(EXE) -- $(abspath bzip2$(EXE)) -3 -k -f /tmp/sample3.ref
	@cp /tmp/sample3.ref.bz2 /tmp/sample3_rt.bz2
	@cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd$(EXE) -- $(abspath bzip2$(EXE)) -ds -k -f /tmp/sample3_rt.bz2
	@cmp /tmp/sample3_rt $(abspath tests/sample3.ref)
	@echo "  PASS: sample3 roundtrip"
	@echo "  Test 4: Decompress reference (sample1.bz2, platform=$(PLATFORM), mode=$(PROCESS_MODE))..."
	@cp $(abspath tests/sample1.bz2) /tmp/sample1_ref.bz2
	@cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd$(EXE) -- $(abspath bzip2$(EXE)) -d -k -f /tmp/sample1_ref.bz2
	@cmp /tmp/sample1_ref $(abspath tests/sample1.ref)
	@echo "  PASS: sample1 decompress reference"
	@echo "  Test 5: Decompress reference (sample2.bz2, platform=$(PLATFORM), mode=$(PROCESS_MODE))..."
	@cp $(abspath tests/sample2.bz2) /tmp/sample2_ref.bz2
	@cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd$(EXE) -- $(abspath bzip2$(EXE)) -d -k -f /tmp/sample2_ref.bz2
	@cmp /tmp/sample2_ref $(abspath tests/sample2.ref)
	@echo "  PASS: sample2 decompress reference"
	@echo "  Test 6: Decompress reference (sample3.bz2, platform=$(PLATFORM), mode=$(PROCESS_MODE))..."
	@cp $(abspath tests/sample3.bz2) /tmp/sample3_ref.bz2
	@cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd$(EXE) -- $(abspath bzip2$(EXE)) -ds -k -f /tmp/sample3_ref.bz2
	@cmp /tmp/sample3_ref $(abspath tests/sample3.ref)
	@echo "  PASS: sample3 decompress reference"
endif
	@echo "  PASS: bzip2 functional tests"

# --- Run tests (alias for functional tests) ---
test: test-functional
	@echo "=== All bzip2 tests PASSED ==="

# ===========================================================================
# Package Target
# ===========================================================================

package:
	@echo "=== Packaging bzip2 release ==="
	$(eval ARTIFACT_NAME := bzip2-$(PLATFORM)-$(PROCESS_MODE)-$(MEMORY_SIZE))
	@for f in $(RELEASE_ARTIFACTS); do \
		if [ ! -f "$$f" ]; then \
			echo "  FAIL: Required artifact not found: $$f"; exit 1; \
		fi; \
	done
	rm -rf dist/$(ARTIFACT_NAME)
	mkdir -p dist/$(ARTIFACT_NAME)/sysroot/lib \
		dist/$(ARTIFACT_NAME)/sysroot/include \
		dist/$(ARTIFACT_NAME)/sysroot/bin
	cp -f $(STATICLIB) dist/$(ARTIFACT_NAME)/sysroot/lib/
	cp -f bzlib.h dist/$(ARTIFACT_NAME)/sysroot/include/
	cp -f $(PROG) dist/$(ARTIFACT_NAME)/sysroot/bin/
	tar -czf dist/$(ARTIFACT_NAME).tar.gz -C dist/$(ARTIFACT_NAME) sysroot
	@echo "  Package: dist/$(ARTIFACT_NAME).tar.gz"
	@echo "  Contents:"
	@tar tzf dist/$(ARTIFACT_NAME).tar.gz | head -20

# ===========================================================================
# Verify Package
# ===========================================================================

verify-package:
	@echo "=== Verifying bzip2 package ==="
	$(eval ARTIFACT_NAME := bzip2-$(PLATFORM)-$(PROCESS_MODE)-$(MEMORY_SIZE))
	@TARBALL="dist/$(ARTIFACT_NAME).tar.gz"; \
	if [ ! -f "$$TARBALL" ]; then \
	  echo "FAIL: Package tarball not found: $$TARBALL"; exit 1; \
	fi; \
	echo "Package contents:"; \
	tar tzf "$$TARBALL"; \
	if ! tar tzf "$$TARBALL" | grep -q 'sysroot/lib/'; then \
	  echo "FAIL: Package missing sysroot/lib/ entries"; exit 1; \
	fi; \
	echo "  PASS: bzip2 package verification"

# ===========================================================================
# Clean
# ===========================================================================

clean:
	rm -f *.o $(STATICLIB) $(PROG)
	rm -f *.a *$(EXE)
	rm -rf dist/

.PHONY: all install clean test test-functional package verify-package
